{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/login",
      "destination": "/api/index.ts"
    },
    {
      "source": "/signup",
      "destination": "/api/index.ts"
    },
    {
      "source": "/logout",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
